<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>super_pf_bridge</name>
  <version>0.0.1</version>
  <description>Bridge: SUPER MINCO polynomial trajectory (ENU) -> A4VAI PathFollowing LocalWaypointSetpoint (NED) + heartbeats.</description>
  <maintainer email="jociiiii@inha.edu">yonghajo</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mars_quadrotor_msgs</depend>
  <depend>custom_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
